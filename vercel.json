{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2678400, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(og-default.jpg|ro-icon.svg|ro-unlimited-logo-transparent.png|ro-unlimited-logo.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "functions": {
    "src/app/api/admin/upload/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/drive/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/drive/file/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/follow-ups",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/email-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
